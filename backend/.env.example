# AbsoluTurf Backend Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in your own values.
# NEVER commit .env to version control.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string
JWT_SECRET_KEY=replace-with-a-different-random-64-char-hex-string

# Allowed frontend origin(s) — comma-separated for multiple
# Examples:
#   Local dev:  http://localhost:3000
#   Production: https://absoluturf.com
CORS_ORIGINS=http://localhost:3000

# Database URL (defaults to SQLite for dev)
DATABASE_URL=sqlite:///absoluturf.db
# Neon alternative (use your own connection string):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require

# Venue-local match times: India = UTC+05:30. Applies to every group in this deployment.
MATCH_UTC_OFFSET_MINUTES=330
